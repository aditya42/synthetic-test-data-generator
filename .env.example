# One source of truth for local development.
PORT=8081
HOST=0.0.0.0
VITE_API_URL=http://127.0.0.1:8081

# PostgreSQL audit/schema persistence is optional.
ENABLE_DB_PERSISTENCE=false
DATABASE_URL=postgres://stdg:stdg@localhost:5432/stdg

# Optional LLM enrichment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# strict = reject suspicious generated PII; warn = return findings without blocking.
PII_BLOCK_MODE=strict
